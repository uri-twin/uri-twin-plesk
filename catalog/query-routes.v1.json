{
  "schema": "uri-twin.plesk.query-catalog/v1",
  "twin_family": "plesk",
  "instance_binding": {
    "required": ["instance_id", "credential_handle"],
    "optional_feature_flags": [
      "has_dns_module",
      "has_ssl_it",
      "has_git_extension"
    ]
  },
  "routes": [
    {
      "id": "subscription-snapshot",
      "uri": "plesk://host/subscription/query/snapshot",
      "twin_type": "plesk.subscription",
      "package": "subscriptions",
      "status": "wired-connector",
      "summary": "Subscription list/capacity snapshot for planning domains"
    },
    {
      "id": "site-docroot",
      "uri": "plesk://host/site/query/docroot",
      "twin_type": "plesk.site.docroot",
      "package": "domain",
      "status": "wired-connector",
      "summary": "Live docroot / www_root decision fact for a domain"
    },
    {
      "id": "dns-authority",
      "uri": "plesk://host/dns/query/authority",
      "twin_type": "plesk.dns.authority",
      "package": "dns",
      "status": "wired-connector",
      "summary": "Normalize connector authority probe into twin-fact envelope"
    }
  ],
  "non_goals_v1": [
    "plesk://host/*/command/*",
    "separate git repos per package",
    "HTTP Control routes as SSOT"
  ]
}
